 "guardrails": {
  "sun-and-shield": {
   "look": "Show the car, then the film. Clean before and after, close detail, slow motion. Calm and premium.",
   "rules": "No \"rock chip warranty\" (XPEL excludes road debris), no 9H or scratch-proof, no durability numbers. Self-heal clips say \"light marring only\". Every offer carries the terms line: valid with a full-vehicle window tint package, one offer per vehicle, cannot be combined, no cash value, mention the code, ends 11:59 PM on the last date. No promos on Veterans Day or Thanksgiving. No fake countdowns."
  },
  "vnphc": {
   "look": "Warm, plain, human. Caregiver and family angle. Never fear.",
   "rules": "Zero client imagery, no anonymized stories. Never imply Medicare pays for private duty home care. Staff footage only with signed release. Wisdom of Elders: no current clients on camera, signed releases from every guest."
  },
  "matchett-homes": {
   "look": "Chris is the face. Trust, 20 years, orderly and unhurried. Customer is 60 and up.",
   "rules": "Talking head and testimonial slots have no assigned topic, Chris picks the clip. Release on file for testimonials. No invented projects, awards or prices."
  },
  "ifab": {
   "look": "The build is the hero. Scale, texture, process. Let the work fill the frame.",
   "rules": "Only projects in the archive or on ifabatl.com. No client names without OK."
  },
  "adnormous": {
   "look": "Transformation first, blank to finished. Material and process close-ups.",
